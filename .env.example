# Vertex AI / Gemini Enterprise
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Force google-genai SDK to use Vertex AI (not API key / AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=true

# Model that supports Grounding with Google Search
# Examples: gemini-2.5-flash, gemini-2.5-pro, gemini-3.5-flash (if enabled in your project)
GEMINI_MODEL=gemini-2.5-flash

# Optional: drop low-confidence grounded spans below this score (0.0–1.0)
MIN_CONFIDENCE=0.65

# Optional: comma-separated domains to exclude from grounding (Vertex)
# EXCLUDE_DOMAINS=example.com,spam.example

# Optional: block risky sites (Vertex only). Examples:
# BLOCK_LOW_AND_ABOVE | BLOCK_MEDIUM_AND_ABOVE | BLOCK_HIGH_AND_ABOVE |
# BLOCK_HIGHER_AND_ABOVE | BLOCK_VERY_HIGH_AND_ABOVE | BLOCK_ONLY_EXTREMELY_HIGH
# BLOCKING_CONFIDENCE=BLOCK_MEDIUM_AND_ABOVE

# Optional: end-user location for localized search (lat,lng)
# USER_LAT_LNG=31.2304,121.4737
