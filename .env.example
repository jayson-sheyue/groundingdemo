# Vertex AI / Gemini (2.5+ recommended)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# gemini-2.5-flash / gemini-2.5-pro / gemini-3.x ...
GEMINI_MODEL=gemini-2.5-flash

# Optional Search filters (Vertex)
# EXCLUDE_DOMAINS=example.com,spam.example
# BLOCKING_CONFIDENCE=BLOCK_MEDIUM_AND_ABOVE

# Optional default lat,lng context (prefer per-request / browser geolocation in apps)
# USER_LAT_LNG=31.2304,121.4737
