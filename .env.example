# Vertex AI / Gemini (2.5+ recommended)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# gemini-2.5-flash / gemini-2.5-pro / gemini-3.x ...
# Image Search grounding 可尝试官方文档中的 image 预览模型，例如：
# GEMINI_MODEL=gemini-3.1-flash-image-preview
GEMINI_MODEL=gemini-2.5-flash

# Optional Search filters (Vertex only; not Gemini Developer API / API key)
# EXCLUDE_DOMAINS=spam.example,low-quality.com
# BLOCKING_CONFIDENCE=BLOCK_MEDIUM_AND_ABOVE

# Optional default lat,lng context (prefer per-request / browser geolocation in apps)
# USER_LAT_LNG=31.2304,121.4737

# Multimodal (Vertex): GCS bucket for relative object paths in UI/CLI --gcs
# Upload PDFs/images to this bucket; service account needs storage.objects.get
GCS_BUCKET=your-gcs-bucket
# Image Search 生图模式（与网页 Search 的 GEMINI_MODEL 不同）
# IMAGE_GEN_MODEL=gemini-3.1-flash-image
# Optional: default-on resolve grounding redirect URLs to final destinations (Web UI can override)
# RESOLVE_GROUNDING_REDIRECTS=true
# Optional prefix for browser uploads (object key: uploads/YYYYMMDD/...)
# GCS_PREFIX=uploads

# Optional token unit price (USD per 1M tokens) — applied to actual usage_metadata after requests
# GEMINI_PRICE_INPUT_PER_MTOK=0.15
# GEMINI_PRICE_OUTPUT_PER_MTOK=0.60
